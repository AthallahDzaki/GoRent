generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model payment {
  id       Int            @id @default(autoincrement())
  rentalId Int
  method   payment_method
  amount   Float
  paidAt   DateTime
  rental   rental         @relation(fields: [rentalId], references: [id], map: "Payment_rentalId_fkey")

  @@index([rentalId], map: "Payment_rentalId_fkey")
}

model rental {
  id         Int           @id @default(autoincrement())
  userId     Int
  vehicleId  Int
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     rental_status
  createdAt  DateTime      @default(now())
  payment    payment[]
  user       user          @relation(fields: [userId], references: [id], map: "Rental_userId_fkey")
  vehicle    vehicle       @relation(fields: [vehicleId], references: [id], map: "Rental_vehicleId_fkey")

  @@index([userId], map: "Rental_userId_fkey")
  @@index([vehicleId], map: "Rental_vehicleId_fkey")
}

model user {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique(map: "User_email_key")
  password  String
  role      user_role @default(customer)
  createdAt DateTime  @default(now())
  rental    rental[]
}

model vehicle {
  id           Int          @id @default(autoincrement())
  name         String
  licensePlate String       @unique(map: "Vehicle_licensePlate_key")
  brand        String
  year         Int
  isAvailable  Boolean      @default(true)
  pricePerDay  Float
  createdAt    DateTime     @default(now())
  rental       rental[]
}

enum payment_method {
  cash
  credit_card
  ewallet
}

enum user_role {
  customer
  admin
}

enum rental_status {
  booked
  ongoing
  completed
  cancelled
}
