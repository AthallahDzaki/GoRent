generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model payment {
  id        Int            @id @default(autoincrement())
  rentalId  Int
  method    payment_method
  amount    Float
  paidAt    DateTime?
  status    payment_status @default(pending)
  createdAt DateTime       @default(now())
  rental    rental         @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
}

model rental {
  id         Int           @id @default(autoincrement())
  userId     Int
  vehicleId  Int
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     rental_status @default(booked)
  createdAt  DateTime      @default(now())
  payment    payment[]
  user       user          @relation(fields: [userId], references: [id])
  vehicle    vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([userId])
  @@index([vehicleId])
}

model user {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  role             user_role @default(customer)
  createdAt        DateTime  @default(now())
  userToken        String?   @db.Text
  rental           rental[]
}

model vehicle {
  id           Int          @id @default(autoincrement())
  name         String
  type         vehicle_type
  licensePlate String       @unique
  brand        String
  year         Int
  status       vehicle_status @default(available)
  isAvailable  Boolean      @default(true)
  pricePerDay  Float
  createdAt    DateTime     @default(now())
  rental       rental[]
}

enum payment_method {
  cash
  credit_card
  ewallet
}

enum user_role {
  customer
  admin
}

enum vehicle_status {
  available
  booked
  rented
  maintenance
  unavailable
}

enum rental_status {
  booked
  ongoing
  completed
  cancelled
}

enum payment_status {
  pending
  completed
  cancelled
  failed
}

enum vehicle_type {
  car
  motorcycle
}
